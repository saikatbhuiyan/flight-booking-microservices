{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/common": [
        "libs/common/src"
      ],
      "@app/common/*": [
        "libs/common/src/*"
      ],
      "@app/circuit-breaker": [
        "libs/circuit-breaker/src"
      ],
      "@app/circuit-breaker/*": [
        "libs/circuit-breaker/src/*"
      ],
      "@app/database": [
        "libs/database/src"
      ],
      "@app/database/*": [
        "libs/database/src/*"
      ],
      "@app/message-broker": [
        "libs/message-broker/src"
      ],
      "@app/message-broker/*": [
        "libs/message-broker/src/*"
      ],
      "@app/rate-limiter": [
        "libs/rate-limiter/src"
      ],
      "@app/rate-limiter/*": [
        "libs/rate-limiter/src/*"
      ],
      "@app/seat-lock": [
        "libs/seat-lock/src"
      ],
      "@app/seat-lock/*": [
        "libs/seat-lock/src/*"
      ],
      "@app/storage": [
        "libs/storage/src"
      ],
      "@app/storage/*": [
        "libs/storage/src/*"
      ],
      "@app/telemetry": [
        "libs/telemetry/src"
      ],
      "@app/telemetry/*": [
        "libs/telemetry/src/*"
      ],
      "@app/transports": [
        "libs/transports/src"
      ],
      "@app/transports/*": [
        "libs/transports/src/*"
      ]
    }
  }
}
