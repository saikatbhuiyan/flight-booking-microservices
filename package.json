{
  "name": "flight-booking",
  "version": "1.0.0",
  "description": "Flight Booking Microservices System",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "prepare": "husky",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:api-gateway": "WATCHPACK_POLLING=true nest start api-gateway --watch",
    "start:auth": "WATCHPACK_POLLING=true nest start auth-service --watch",
    "start:flight": "WATCHPACK_POLLING=true nest start flight-service --watch",
    "start:booking": "WATCHPACK_POLLING=true nest start booking-service --watch",
    "start:notification": "WATCHPACK_POLLING=true nest start notification-service --watch",
    "start:payment": "WATCHPACK_POLLING=true nest start payment-service --watch",
    "start:all": "concurrently \"npm:start:api-gateway\" \"npm:start:auth\" \"npm:start:flight\" \"npm:start:booking\" \"npm:start:notification\" \"npm:start:payment\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "setup:localstack": "aws --endpoint-url=http://localhost:4566 s3 mb s3://flight-booking-bucket",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate:auth": "npm run typeorm -- migration:generate -d libs/database/src/data-sources/auth.datasource.ts",
    "migration:run:auth": "npm run typeorm -- migration:run -d libs/database/src/data-sources/auth.datasource.ts",
    "migration:revert:auth": "npm run typeorm -- migration:revert -d libs/database/src/data-sources/auth.datasource.ts",
    "migration:generate:booking": "npm run typeorm -- migration:generate -d libs/database/src/data-sources/booking.datasource.ts",
    "migration:run:booking": "npm run typeorm -- migration:run -d libs/database/src/data-sources/booking.datasource.ts",
    "migration:revert:booking": "npm run typeorm -- migration:revert -d libs/database/src/data-sources/booking.datasource.ts",
    "migration:generate:flight": "npm run typeorm -- migration:generate -d libs/database/src/data-sources/flight.datasource.ts",
    "migration:run:flight": "npm run typeorm -- migration:run -d libs/database/src/data-sources/flight.datasource.ts",
    "migration:revert:flight": "npm run typeorm -- migration:revert -d libs/database/src/data-sources/flight.datasource.ts",
    "migration:generate:payment": "npm run typeorm -- migration:generate -d libs/database/src/data-sources/payment.datasource.ts",
    "migration:run:payment": "npm run typeorm -- migration:run -d libs/database/src/data-sources/payment.datasource.ts",
    "migration:revert:payment": "npm run typeorm -- migration:revert -d libs/database/src/data-sources/payment.datasource.ts",
    "migration:create:auth": "npm run typeorm -- migration:create",
    "migration:create:booking": "npm run typeorm -- migration:create apps/booking-service/src/migrations/Migration",
    "migration:create:flight": "npm run typeorm -- migration:create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.914.0",
    "@aws-sdk/s3-request-presigner": "^3.914.0",
    "@golevelup/nestjs-rabbitmq": "^7.1.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.1.7",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.47.1",
    "@opentelemetry/exporter-jaeger": "^2.5.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "dotenv": "^17.2.2",
    "eventemitter2": "^6.4.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.1",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "redis": "^5.8.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^20.3.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/message-broker(|/.*)$": "<rootDir>/libs/message-broker/src/$1",
      "^@app/storage(|/.*)$": "<rootDir>/libs/storage/src/$1",
      "^@app/seat-lock(|/.*)$": "<rootDir>/libs/seat-lock/src/$1",
      "^@app/rate-limiter(|/.*)$": "<rootDir>/libs/rate-limiter/src/$1",
      "^@app/telemetry(|/.*)$": "<rootDir>/libs/telemetry/src/$1"
    }
  }
}
